# Copy to .env, fill in your paths, then: set -a; source .env; set +a
# Paths with spaces should be quoted. No weights or datasets are bundled.
DGN_ROOT=/path/to/DGN/meta-v8
DGN_POSE_ROOT=/path/to/DGN/meta-v8/unique_dgn_poses
ICP_CKPT=/path/to/512-32-balanced-SAM-wd-5e-05-920
TEACHER_CKPT=/path/to/teacher/run-000/ckpt/step-245760.ckpt
# Training: teacher or compatible student stats. Evaluation: exact STUDENT_CKPT pair.
ENV_CKPT=/path/to/run-000/stat/env-245760.ckpt
FT_CKPT=/path/to/ft_best.pt
STUDENT_CKPT=/path/to/student/run-000/ckpt/step-200000.ckpt
BUFFER_PATH=/path/to/teacher_buffer.pt
